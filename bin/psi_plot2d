matplotlib.use('Agg')
from matplotlib.lines import Line2D
import matplotlib.pyplot as plt
import numpy as np
from mpl_toolkits.axes_grid1.axes_divider import make_axes_locatable

import psipals
import psimath
try:
  import psi_io as ps
  PSI_IO_AVAIL = True
except ImportError:
  import psihdf as ps
  PSI_IO_AVAIL = False

